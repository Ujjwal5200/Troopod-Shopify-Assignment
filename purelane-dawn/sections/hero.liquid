<section class="hero" id="hero">
  <div class="hero-grid">
    {% if section.settings.bg_image %}
      <div class="hero-bg" style="background-image: url({{ section.settings.bg_image | img_url: '2048x2048' }});" role="img" aria-label="{{ section.settings.heading | escape }}"></div>
    {% endif %}
    <div class="hero-copy">
      <h1 class="d1 rv in">{{ section.settings.heading | escape }}</h1>
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede rv rv-d2">{{ section.settings.subheading | escape }}</p>
      <div class="hero-cta rv rv-d3">
        <a href="{{ section.settings.button_link }}" class="btn btn-primary">{{ section.settings.button_text | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>
        {% if section.settings.button_2_link != blank %}
          <a href="{{ section.settings.button_2_link }}" class="btn btn-ghost">{{ section.settings.button_2_text | escape }}</a>
        {% endif %}
      </div>
      <div class="badgestrip rv rv-d4">
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          Plant powered
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
          Kids &amp; pet safe
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
          Zero harsh chem
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clean That Lasts" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Homecare that works on the toughest grime, made from plants." },
    { "type": "url", "id": "button_link", "label": "Primary button link", "default": "#shop" },
    { "type": "text", "id": "button_text", "label": "Primary button text", "default": "Shop now" },
    { "type": "url", "id": "button_2_link", "label": "Secondary button link" },
    { "type": "text", "id": "button_2_text", "label": "Secondary button text", "default": "How it works" }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
