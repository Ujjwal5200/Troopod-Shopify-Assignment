<section class="sec" id="whybundles" data-scene="4">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        <span class="kicker">The smarter way to shop</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Why bundles beat buying single' }}</h2>
      </div>
      <div class="wb">
        {% for block in section.blocks %}
          <div class="wb-i">
            <span class="ci">{{ block.settings.icon }}</span>
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.text }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Why Bundles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why bundles beat buying single" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "textarea", "id": "icon", "label": "Icon SVG", "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v18\"/><path d=\"M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2\"/></svg>" },
        { "type": "text", "id": "title", "label": "Title", "default": "Save up to 45%" },
        { "type": "text", "id": "text", "label": "Text", "default": "Versus buying the same products separately" }
      ]
    }
  ],
  "presets": [{ "name": "Why Bundles" }]
}
{% endschema %}
