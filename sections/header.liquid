<header id="hdr">
  <div class="navpill glass">
    <a class="brand" href="{{ section.settings.brand_link | default: '/' }}" aria-label="{{ section.settings.brand_name | default: 'Purelane' }} home">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
          <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
          <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
        </svg>
      </span>
      <span class="txt">
        <span class="n1">{{ section.settings.brand_name | default: 'Purelane' }}</span>
        <span class="n2">{{ section.settings.brand_tagline | default: 'Clean, simply' }}</span>
      </span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href="{{ section.settings.nav_home_url | default: '/' }}">{{ section.settings.nav_home | default: 'Home' }}</a>
      <a href="#ingredients">{{ section.settings.nav_ingredients | default: 'Ingredients' }}</a>
      <a href="#how">{{ section.settings.nav_how | default: 'How it works' }}</a>
      <a href="{{ section.settings.nav_shop_url | default: '/collections/all' }}">{{ section.settings.nav_shop | default: 'Shop' }}</a>
      <a href="#bundles">{{ section.settings.nav_bundles | default: 'Bundles' }}</a>
    </nav>
    <div class="navtools">
      <button class="ico hide-s" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <button class="ico hide-s" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg>
      </button>
      <button class="ico" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg>
        <span class="dot">0</span>
      </button>
      <button class="ico burger" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Purelane" },
    { "type": "text", "id": "brand_tagline", "label": "Brand tagline", "default": "Clean, simply" },
    { "type": "url", "id": "brand_link", "label": "Brand link", "default": "/" },
    { "type": "text", "id": "nav_home", "label": "Home link text", "default": "Home" },
    { "type": "url", "id": "nav_home_url", "label": "Home link URL", "default": "/" },
    { "type": "text", "id": "nav_ingredients", "label": "Ingredients link text", "default": "Ingredients" },
    { "type": "text", "id": "nav_how", "label": "How it works link text", "default": "How it works" },
    { "type": "text", "id": "nav_shop", "label": "Shop link text", "default": "Shop" },
    { "type": "url", "id": "nav_shop_url", "label": "Shop link URL", "default": "/collections/all" },
    { "type": "text", "id": "nav_bundles", "label": "Bundles link text", "default": "Bundles" }
  ],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
