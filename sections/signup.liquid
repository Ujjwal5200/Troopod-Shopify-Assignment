<section class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Join the Purelane Club' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Get ₹100 off your first bundle' }}</h2>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.lede | default: 'Sign up for tips, offers and first access to new drops.' }}</p>
      <form class="sform" action="{{ section.settings.form_action | default: '/contact' }}" method="post">
        <input type="email" name="email" placeholder="Your email address" required aria-label="Email address">
        <button class="btn btn-primary btn-sm" type="submit">Sign up</button>
      </form>
      <p class="fine">{{ section.settings.fine | default: 'No spam. Unsubscribe anytime.' }}</p>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Signup",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Join the Purelane Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get ₹100 off your first bundle" },
    { "type": "text", "id": "lede", "label": "Lede", "default": "Sign up for tips, offers and first access to new drops." },
    { "type": "text", "id": "form_action", "label": "Form action URL", "default": "/contact" },
    { "type": "text", "id": "fine", "label": "Fine print", "default": "No spam. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Signup" }]
}
{% endschema %}
