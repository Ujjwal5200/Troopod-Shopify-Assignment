<section class="sec" data-scene="4" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">Join the Purelane Club</span>
      <h2 class="d2" style="margin-top:12px">Get ₹100 off your first bundle</h2>
      <p class="lede" style="margin:0 auto">Plus first access to new launches and restocks.</p>
      <form onsubmit="return false">
        <input type="email" placeholder="your@email.com" aria-label="Email address" required>
        <button class="btn btn-primary" type="submit">Get my ₹100 off</button>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Signup",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Plus first access to new launches and restocks."
    }
  ],
  "presets": [
    {
      "name": "Signup",
      "category": "Text"
    }
  ]
}
{% endschema %}
