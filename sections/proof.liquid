<section class="sec" id="proof" data-scene="2">
  <div class="wrap">
    <div class="proof rv">
      <div class="proof-copy">
        <span class="kicker">The proof is in the numbers</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Trusted across India' }}</h2>
        <div class="rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
        <div class="stats">
          {% for block in section.blocks %}
            <div class="stat">
              <b>{{ block.settings.number }}</b>
              <span>{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="rot" aria-label="Product showcase">
        <div class="frame">
          {% for block in section.blocks %}
            {% if block.settings.product != blank %}
              <span class="pimg on" role="img" aria-label="{{ block.settings.product.title }}">
                <img src="{{ block.settings.product.featured_image | img_url: '400x' }}" alt="{{ block.settings.product.title | escape }}" loading="lazy">
              </span>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Proof",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted across India" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "30,000+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Happy homes" }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [{ "name": "Proof" }]
}
{% endschema %}
