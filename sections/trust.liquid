<section class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass trust rv">
      <div class="trust-i">
        {% for block in section.blocks %}
          <span class="ti" aria-label="{{ block.settings.title | default: 'Trust badge' }}">
            {{ block.settings.icon }}
            {% if block.settings.title != blank %}<b>{{ block.settings.title }}</b>{% endif %}
          </span>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Trust Bar",
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "textarea", "id": "icon", "label": "Icon SVG", "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z\"/><path d=\"M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z\"/></svg>" },
        { "type": "text", "id": "title", "label": "Title", "default": "100% plant-based" }
      ]
    }
  ],
  "presets": [{ "name": "Trust Bar" }]
}
{% endschema %}
