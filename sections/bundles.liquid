<section class="sec" id="bundles" data-scene="3" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">Build your bundle</span>
        <h2 class="d2" style="margin-top:12px">One box. Every room.</h2>
        <p class="lede" style="margin:0 auto">Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.</p>
      </div>
    </div>
    <div class="tiers">
      {% for block in section.blocks %}
      <article class="glass tier rv{% if block.settings.featured %} best{% endif %}{% if forloop.index == 2 %} rv-d2{% elsif forloop.index == 3 %} rv-d3{% endif %}">
        <span class="tag">{{ block.settings.tag | default: 'Starter' }}</span>
        <div class="tierpix{% if block.settings.product_count == '5' %} five{% endif %}" aria-hidden="true">
          {% assign products = block.settings.product_handles | split: ',' %}
          {% for handle in products %}
            {% assign prod = all_products[handle | strip] %}
            {% if prod and prod.featured_image %}
              <span class="pimg" role="img" aria-label="{{ prod.title }}" style="background-image: url({{ prod.featured_image | img_url: '150x' }})"></span>
            {% else %}
              <span class="pimg p-combo2" role="img" aria-label="Combo product"></span>
            {% endif %}
          {% endfor %}
        </div>
        <div class="qty">{{ block.settings.product_count | default: '2' }}<small>Products</small></div>
        <div class="price">{{ block.settings.price | default: '₹349' }} <s>{{ block.settings.compare | default: '₹598' }}</s></div>
        <p class="body-s" style="font-size:12px">Flat {{ block.settings.per_product | default: '₹174' }} per product</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_1 | default: 'Pick any two products' }}</li>
          {% if block.settings.feature_2 != blank %}
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_2 }}</li>
          {% endif %}
          {% if block.settings.feature_3 != blank %}
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_3 }}</li>
          {% endif %}
        </ul>
        <a class="btn{% if block.settings.featured %} btn-primary{% else %} btn-ghost{% endif %}" href="#shop">Build this box
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        </a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "class": "bundles-section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Badge text",
          "default": "Starter"
        },
        {
          "type": "text",
          "id": "product_count",
          "label": "Product count",
          "default": "2"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Bundle price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare",
          "label": "Compare at price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_product",
          "label": "Per product price",
          "default": "₹174"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": ""
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Mark as most popular",
          "default": false
        },
        {
          "type": "text",
          "id": "product_handles",
          "label": "Product image handles (comma separated)",
          "default": "kitchen-cleaner,tap-cleaner",
          "info": "Enter product handles to show their images in the tier"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles",
      "category": "Collection",
      "blocks": [
        { "type": "tier", "settings": { "tag": "Starter", "product_count": "2", "price": "₹349", "compare": "₹598", "per_product": "₹174", "feature_1": "Pick any two products", "feature_2": "Free shipping across India", "product_handles": "kitchen-cleaner,tap-cleaner" } },
        { "type": "tier", "settings": { "tag": "Most popular", "product_count": "3", "price": "₹499", "compare": "₹897", "per_product": "₹166", "feature_1": "Pick any three products", "feature_2": "Covers kitchen and laundry", "feature_3": "Free shipping across India", "featured": true, "product_handles": "kitchen-cleaner,tap-cleaner,dishwash-gel" } },
        { "type": "tier", "settings": { "tag": "Whole home", "product_count": "5", "price": "₹799", "compare": "₹1495", "per_product": "₹160", "feature_1": "Pick any five products", "feature_2": "Every room in one order", "feature_3": "Free shipping across India", "product_handles": "kitchen-cleaner,laundry-detergent,floor-cleaner,toilet-cleaner,tap-cleaner" } }
      ]
    }
  ]
}
{% endschema %}
