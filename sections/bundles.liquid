<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">Build your bundle</span>
        <h2 class="d2" style="margin-top:12px">One box. Every room.</h2>
        <p class="lede" style="margin:0 auto">Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.</p>
      </div>
    </div>
    <div class="tiers">
      {% for block in section.blocks %}
        {% assign product_1 = block.settings.product_1 %}
        {% assign product_2 = block.settings.product_2 %}
        {% assign product_3 = block.settings.product_3 %}
        {% assign product_count = 0 %}
        {% if product_1 != blank %}{% assign product_count = product_count | plus: 1 %}{% endif %}
        {% if product_2 != blank %}{% assign product_count = product_count | plus: 1 %}{% endif %}
        {% if product_3 != blank %}{% assign product_count = product_count | plus: 1 %}{% endif %}
        <article class="glass tier rv{% if block.settings.featured %} best rv-d2{% endif %}{% if forloop.index == 3 %} rv-d3{% endif %}" {{ block.shopify_attributes }}>
          {% if block.settings.tag != blank %}<span class="tag">{{ block.settings.tag }}</span>{% endif %}
          <div class="tierpix{% if product_count == 5 %} five{% endif %}" aria-hidden="true">
            {% if product_1 != blank %}
              <span class="pimg" role="img" aria-label="{{ product_1.title }}">
                <img src="{{ product_1.featured_image | img_url: '200x' }}" alt="{{ product_1.title | escape }}" loading="lazy">
              </span>
            {% endif %}
            {% if product_2 != blank %}
              <span class="pimg" role="img" aria-label="{{ product_2.title }}">
                <img src="{{ product_2.featured_image | img_url: '200x' }}" alt="{{ product_2.title | escape }}" loading="lazy">
              </span>
            {% endif %}
            {% if product_3 != blank %}
              <span class="pimg" role="img" aria-label="{{ product_3.title }}">
                <img src="{{ product_3.featured_image | img_url: '200x' }}" alt="{{ product_3.title | escape }}" loading="lazy">
              </span>
            {% endif %}
          </div>
          <div class="qty">{{ product_count }}<small>Products</small></div>
          <div class="price">{{ block.settings.price }} <s>{{ block.settings.compare_price }}</s></div>
          <p class="body-s" style="font-size:12px">{{ block.settings.per_product }}</p>
          <ul>
            {% if block.settings.feature_1 != blank %}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_1 }}</li>
            {% endif %}
            {% if block.settings.feature_2 != blank %}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_2 }}</li>
            {% endif %}
            {% if block.settings.feature_3 != blank %}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_3 }}</li>
            {% endif %}
          </ul>
          <a class="btn{% if block.settings.featured %} btn-primary{% else %} btn-ghost{% endif %}" href="{{ block.settings.link }}">Build this box
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Bundles",
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Starter" },
        { "type": "text", "id": "qty", "label": "Product count", "default": "2" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹349" },
        { "type": "text", "id": "compare_price", "label": "Compare at price", "default": "₹598" },
        { "type": "text", "id": "per_product", "label": "Per product note", "default": "Flat ₹174 per product" },
        { "type": "text", "id": "feature_1", "label": "Feature 1", "default": "Pick any two products" },
        { "type": "text", "id": "feature_2", "label": "Feature 2", "default": "Free shipping across India" },
        { "type": "text", "id": "feature_3", "label": "Feature 3" },
        { "type": "url", "id": "link", "label": "Link", "default": "/collections/all" },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "product", "id": "product_3", "label": "Product 3" },
        { "type": "checkbox", "id": "featured", "label": "Mark as most popular", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Bundles" }]
}
{% endschema %}
