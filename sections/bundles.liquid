<section class="sec" id="bundles">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">Build your bundle</span>
        <h2 class="d2" style="margin-top:12px">One box. Every room.</h2>
        <p class="lede" style="margin:0 auto">Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.</p>
      </div>
    </div>
    {% if section.blocks.size > 0 %}
      <div class="tiers">
        {% for block in section.blocks %}
          <article class="glass tier rv {% if block.settings.featured %}best{% endif %}">
            {% if block.settings.tag != blank %}
              <span class="tag">{{ block.settings.tag | escape }}</span>
            {% endif %}
            <div class="tierpix" aria-hidden="true">
              {% for i in (1..3) %}
                {% assign p = block.settings['product_' | append: i] %}
                {% if p and p.featured_image %}
                  <img src="{{ p.featured_image | img_url: '80x80' }}" alt="{{ p.title | escape }}" class="pimg" loading="lazy">
                {% endif %}
              {% endfor %}
            </div>
            <div class="qty">{{ block.settings.qty | default: 3 }}<small>Products</small></div>
            <div class="price">{{ block.settings.price }} <s>{{ block.settings.compare_price }}</s></div>
            <p class="body-s" style="font-size:12px">{{ block.settings.per_product | default: 'Flat price per product' }}</p>
            <ul>
              {% if block.settings.feature_1 != blank %}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_1 | escape }}</li>
              {% endif %}
              {% if block.settings.feature_2 != blank %}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_2 | escape }}</li>
              {% endif %}
              {% if block.settings.feature_3 != blank %}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_3 | escape }}</li>
              {% endif %}
            </ul>
            <a href="{{ block.settings.link | default: '#shop' }}" class="btn btn-ghost">Build this box</a>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Bundles",
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Starter" },
        { "type": "text", "id": "qty", "label": "Product count", "default": "2" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹349" },
        { "type": "text", "id": "compare_price", "label": "Compare at price", "default": "₹598" },
        { "type": "text", "id": "per_product", "label": "Per product note", "default": "Flat ₹174 per product" },
        { "type": "text", "id": "feature_1", "label": "Feature 1", "default": "Pick any two products" },
        { "type": "text", "id": "feature_2", "label": "Feature 2", "default": "Free shipping across India" },
        { "type": "text", "id": "feature_3", "label": "Feature 3" },
        { "type": "url", "id": "link", "label": "Link", "default": "#shop" },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "product", "id": "product_3", "label": "Product 3" },
        { "type": "checkbox", "id": "featured", "label": "Mark as most popular", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Bundles" }]
}
{% endschema %}
