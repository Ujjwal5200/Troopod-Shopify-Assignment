<section class="sec" id="ingredients" data-scene="2">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">What's inside</span>
      <h2 class="d2" style="margin-top:12px">Plant-powered, not plant-washed</h2>
      <div class="rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
      <p class="lede" style="margin:14px auto 0">Every formula starts with ingredients you can pronounce. No hidden chemicals, no fine print.</p>
    </div>
    <div class="ings">
      {% for block in section.blocks %}
        <div class="ing rv" {{ block.shopify_attributes }}>
          <span class="ici" aria-hidden="true">{{ block.settings.icon }}</span>
          <h4>{{ block.settings.title }}</h4>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Ingredients",
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "textarea", "id": "icon", "label": "Icon SVG", "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22c4-4 8-7.5 8-12a8 8 0 1 0-16 0c0 4.5 4 8 8 12z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>" },
        { "type": "text", "id": "title", "label": "Title", "default": "Coconut-derived surfactants" },
        { "type": "text", "id": "text", "label": "Text", "default": "Lifts grease without stripping skin or surfaces" }
      ]
    }
  ],
  "presets": [{ "name": "Ingredients" }]
}
{% endschema %}
