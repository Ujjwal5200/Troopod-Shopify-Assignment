<section class="sec" id="categories" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">Bundle categories</span>
      <h2 class="d2" style="margin-top:12px">Find the right bundle for you</h2>
    </div>
    <div class="cats">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
        <a class="glass cat rv{% if forloop.index == 2 %} rv-d1{% elsif forloop.index == 3 %} rv-d2{% elsif forloop.index == 4 %} rv-d3{% endif %}" href="{{ collection.url | default: '#combos' }}" {{ block.shopify_attributes }}>
          <span class="ph">
            {% if collection.featured_image %}
              <span class="pimg" role="img" aria-label="{{ collection.title }}">
                <img src="{{ collection.featured_image | img_url: '400x' }}" alt="{{ collection.title | escape }}" loading="lazy">
              </span>
            {% elsif block.settings.image %}
              <span class="pimg" role="img" aria-label="{{ block.settings.title | default: block.settings.collection }}">
                <img src="{{ block.settings.image | img_url: '400x' }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              </span>
            {% endif %}
          </span>
          <span class="txt">
            <h4>{{ block.settings.title | default: collection.title }}</h4>
            <p>{{ block.settings.subtitle | default: collection.description | truncate: 60 }}</p>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Bundle Categories",
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Kitchen bundle" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Grease, dishes & more" }
      ]
    }
  ],
  "presets": [{ "name": "Bundle Categories" }]
}
{% endschema %}
