<section class="sec" id="how" data-scene="2">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">How it works</span>
      <h2 class="d2" style="margin-top:12px">Three steps to a cleaner home</h2>
    </div>
    <div class="pillars">
      {% for block in section.blocks %}
        <div class="glass pillar rv{% if forloop.index == 2 %} rv-d1{% elsif forloop.index == 3 %} rv-d2{% endif %}" {{ block.shopify_attributes }}>
          <span class="pico" aria-hidden="true">{{ block.settings.icon }}</span>
          <h4>{{ block.settings.title }}</h4>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Pillars",
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "textarea", "id": "icon", "label": "Icon SVG", "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 12l2 2 4-4\"/><path d=\"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z\"/></svg>" },
        { "type": "text", "id": "title", "label": "Title", "default": "Pick your products" },
        { "type": "text", "id": "text", "label": "Text", "default": "Choose from kitchen, laundry, bathroom and skin-safe formulas." }
      ]
    }
  ],
  "presets": [{ "name": "Pillars" }]
}
{% endschema %}
