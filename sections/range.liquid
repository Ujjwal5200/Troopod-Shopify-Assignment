<section class="sec" id="range" data-scene="3">
  <div class="wrap">
    <div class="glass range rv">
      <div class="range-head">
        <div>
          <span class="kicker">The full range</span>
          <h2 class="d2" style="margin-top:10px">Every room, one shelf</h2>
        </div>
        <p class="body-s" style="max-width:34ch;margin-bottom:4px">{{ section.settings.range_description | default: 'Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink.' }}</p>
      </div>
      <div class="stripwrap">
        <div class="rangerow">
          {% for product in section.settings.featured_products %}
            <span class="pimg" role="img" aria-label="{{ product.title }}">
              <img src="{{ product.featured_image | img_url: '200x' }}" alt="{{ product.title | escape }}" loading="lazy">
            </span>
          {% else %}
            {% for i in (1..8) %}
              <span class="pimg" aria-hidden="true"></span>
            {% endfor %}
          {% endfor %}
        </div>
      </div>
      <p class="striphint">Swipe to see the full shelf</p>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Full Range",
  "settings": [
    { "type": "textarea", "id": "range_description", "label": "Description", "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink." },
    {
      "type": "product_list",
      "id": "featured_products",
      "label": "Products",
      "default": [],
      "limit": 12
    }
  ],
  "presets": [{ "name": "Full Range" }]
}
{% endschema %}
