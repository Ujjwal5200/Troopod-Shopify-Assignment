<section class="sec" id="shop" data-scene="3" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">Bestsellers</span>
      <h2 class="d2" style="margin-top:12px">Loved by 30,000 homes</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>
    <div class="shelf">
      {% assign product_count = 0 %}
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% assign product_count = product_count | plus: 1 %}
        <article class="glass card rv rv-d{{ product_count | modulo: 5 }}">
          <div class="shot">
            {% if product.featured_image %}
              <span class="pimg" role="img" aria-label="{{ product.title }}" style="background-image: url({{ product.featured_image | img_url: '300x' }})"></span>
            {% else %}
              <span class="pimg" role="img" aria-label="{{ product.title }}" style="background-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 300 300%22%3E%3Crect fill=%22%234b3a8f%22 width=%22300%22 height=%22300%22/%3E%3Ctext fill=%22%23faf7fd%22 font-family=%22sans-serif%22 font-size=%2216%22 x=%2250%25%22 y=%2250%25%22 text-anchor=%22middle%22 dy=%22.3em%22%3ENo Image%3C/text%3E%3C/svg%3E')"></span>
            {% endif %}
            {% if product.available == false %}
              <span class="pill" style="background:rgba(23,16,43,.8);border-color:rgba(240,160,60,.4);color:#f0a03c">Sold out</span>
            {% else %}
              <span class="pill">Best seller</span>
            {% endif %}
          </div>
          <h4>{{ product.title }}</h4>
          <div class="rate">
            <b>&starf; 4.8</b> &middot; {{ product.metafields.custom.review_count | default: 100 | round }} reviews
          </div>
          <div class="pr">
            <strong>{{ product.price | money }}</strong>
            {% if product.compare_at_price_max and product.compare_at_price_max > product.price %}
              <s>{{ product.compare_at_price_max | money }}</s>
              {% assign discount = product.price | times: 100 | divided_by: product.compare_at_price_max | round | times: -1 | plus: 100 %}
              <em>{{ discount }}% off</em>
            {% endif %}
          </div>
          <button class="btn btn-ghost btn-sm"{% unless product.available %} disabled{% endunless %}>
            {% if product.available %}Add to cart{% else %}Sold out{% endif %}
          </button>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "tag": "section",
  "class": "shop-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "default": "frontpage"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Shop / Product Grid",
      "category": "Collection",
      "settings": {
        "collection": "frontpage",
        "products_to_show": 8
      }
    }
  ]
}
{% endschema %}
