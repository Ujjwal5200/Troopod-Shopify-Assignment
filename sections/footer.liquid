<footer>
  <div class="wrap">
    <div class="fgrid">
      <div class="fcol">
        <a class="brand" href="/" style="margin-bottom:16px">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 7.5 20 12 21Z"/><path d="M12 21v-6"/></svg>
          </span>
          <span class="txt"><span class="n1">Purelane</span><span class="n2">Clean, simply</span></span>
        </a>
        <p style="max-width:30ch">Effective cleaning, powered by nature. Made for Indian homes since day one.</p>
      </div>
      <div class="fcol">
        <h5>Shop</h5>
        <a href="/collections/all">Bestsellers</a>
        <a href="/collections/all">Kitchen</a>
        <a href="/collections/all">Laundry</a>
        <a href="/collections/all">Home</a>
        <a href="/collections/all">Skin</a>
        <a href="#bundles">Starter kits</a>
      </div>
      <div class="fcol">
        <h5>About</h5>
        <a href="#how">How it works</a>
        <a href="#ingredients">Sustainability</a>
        <a href="#proof">FAQs</a>
        <a href="#reviews">Reviews</a>
      </div>
      <div class="fcol">
        <h5>Get in touch</h5>
        <a href="mailto:{{ section.settings.email | default: 'hello@purelane.com' }}">{{ section.settings.email | default: 'hello@purelane.com' }}</a>
        <a href="tel:{{ section.settings.phone | default: '+919930123234' }}">{{ section.settings.phone | default: '+91 9930 123 234' }}</a>
        <p style="font-size:12px;color:var(--paper-3)">{{ section.settings.company_name | default: 'Purelane Eco Products Pvt Ltd' }}</p>
      </div>
    </div>
    <div class="fbot">
      <span>© 2026 {{ section.settings.company_name | default: 'Purelane Eco Products Private Limited' }}</span>
      <span>Privacy · Terms · Refunds · Contact</span>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Purelane" },
    { "type": "text", "id": "brand_tagline", "label": "Brand tagline", "default": "Clean, simply" },
    { "type": "text", "id": "email", "label": "Support email", "default": "hello@purelane.com" },
    { "type": "text", "id": "phone", "label": "Support phone", "default": "+91 9930 123 234" },
    { "type": "text", "id": "company_name", "label": "Company name", "default": "Purelane Eco Products Pvt Ltd" }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
