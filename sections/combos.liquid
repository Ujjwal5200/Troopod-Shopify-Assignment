<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">Pre-built to save you money</span>
      <h2 class="d2" style="margin-top:12px">Best selling combos</h2>
      <div class="rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
      <p class="lede" style="margin:14px auto 0">Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.</p>
    </div>
    <div class="comborail rv">
      {% for block in section.blocks %}
        {% assign product_1 = block.settings.product_1 %}
        {% assign product_2 = block.settings.product_2 %}
        {% assign product_count = 0 %}
        {% if product_1 != blank %}{% assign product_count = product_count | plus: 1 %}{% endif %}
        {% if product_2 != blank %}{% assign product_count = product_count | plus: 1 %}{% endif %}
        <article class="glass combo" {{ block.shopify_attributes }}>
          <div class="tray">
            {% if block.settings.save_label != blank %}<span class="save">{{ block.settings.save_label }}</span>{% endif %}
            {% if block.settings.flag != blank %}<span class="flag">{{ block.settings.flag }}</span>{% endif %}
            <div class="stack">
              {% if product_1 != blank %}
                <span class="it">
                  <span class="pimg" role="img" aria-label="{{ product_1.title }}">
                    <img src="{{ product_1.featured_image | img_url: '200x' }}" alt="{{ product_1.title | escape }}" loading="lazy">
                  </span>
                  <span>{{ product_1.title | truncate: 40 }}</span>
                </span>
              {% endif %}
              {% if product_1 != blank and product_2 != blank %}<span class="plus" aria-hidden="true">+</span>{% endif %}
              {% if product_2 != blank %}
                <span class="it">
                  <span class="pimg" role="img" aria-label="{{ product_2.title }}">
                    <img src="{{ product_2.featured_image | img_url: '200x' }}" alt="{{ product_2.title | escape }}" loading="lazy">
                  </span>
                  <span>{{ product_2.title | truncate: 40 }}</span>
                </span>
              {% endif %}
            </div>
          </div>
          <div class="body">
            <h3>{{ block.settings.combo_title }}</h3>
            <div class="cnt">{{ product_count }} products</div>
            <p class="inc">{{ block.settings.combo_desc }}</p>
            <div class="prow"><strong>{{ block.settings.combo_price }}</strong><s>{{ block.settings.combo_compare_price }}</s><em>Save {{ block.settings.save_amount }}</em></div>
            <div class="fine">Inclusive of all taxes &middot; COD available</div>
            <a class="btn btn-ghost" href="{{ block.settings.combo_link }}">Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>
          </div>
        </article>
      {% endfor %}
    </div>
    <div class="swipecue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>Swipe for more combos</div>
    <p class="railnote">Tapping "Shop bundle" opens the bundle picker with these products already added. You can still swap anything before you pay.</p>
  </div>
</section>
{% schema %}
{
  "name": "Best-selling Combos",
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "text", "id": "combo_title", "label": "Combo title", "default": "Kitchen essentials" },
        { "type": "text", "id": "combo_desc", "label": "Description", "default": "Everything for a sparkling kitchen." },
        { "type": "text", "id": "save_label", "label": "Save label", "default": "You save ₹398" },
        { "type": "text", "id": "save_amount", "label": "Save amount", "default": "₹398" },
        { "type": "text", "id": "flag", "label": "Flag", "default": "Most popular" },
        { "type": "text", "id": "combo_price", "label": "Combo price", "default": "₹499" },
        { "type": "text", "id": "combo_compare_price", "label": "Compare at price", "default": "₹897" },
        { "type": "text", "id": "combo_products", "label": "Product count label", "default": "3 products" },
        { "type": "url", "id": "combo_link", "label": "Link", "default": "/collections/all" },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" }
      ]
    }
  ],
  "presets": [{ "name": "Combos Rail" }]
}
{% endschema %}
