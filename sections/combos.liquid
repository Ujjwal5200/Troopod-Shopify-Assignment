<section class="sec" id="combos">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">Pre-built to save you money</span>
      <h2 class="d2" style="margin-top:12px">Best selling combos</h2>
      <div class="rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
      <p class="lede" style="margin:14px auto 0">Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.</p>
    </div>
    {% if section.blocks.size > 0 %}
      <div class="comborail rv">
        {% for block in section.blocks %}
          <article class="glass combo">
            <div class="tray">
              {% if block.settings.combo_text != blank %}
                <span class="save">{{ block.settings.combo_text | escape }}</span>
              {% endif %}
              <div class="stack">
                {% for i in (1..2) %}
                  {% assign product_key = 'product_' | append: i %}
                  {% assign p = block.settings[product_key] %}
                  {% if p %}
                    <span class="it">
                      <a href="{{ p.url }}">
                        {% if p.featured_image %}
                          <img src="{{ p.featured_image | img_url: '100x100' }}" alt="{{ p.title | escape }}" class="pimg" loading="lazy">
                        {% else %}
                          <div class="pimg tile" style="background:rgba(236,230,247,.08);border:1px dashed rgba(236,230,247,.26);display:grid;place-items:center;color:var(--accent);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em">No img</div>
                        {% endif %}
                        <span>{{ p.title | truncate: 25 }}</span>
                      </a>
                    </span>
                    {% if i == 1 %}<span class="plus" aria-hidden="true">+</span>{% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
            <div class="body">
              <h3>{{ block.settings.combo_title | escape }}</h3>
              <div class="cnt">{{ block.settings.combo_products | default: '2 products' }}</div>
              <p class="inc">{{ block.settings.combo_desc | escape }}</p>
              <div class="prow">
                <strong>{{ block.settings.combo_price | default: '₹499' }}</strong>
                {% if block.settings.combo_compare_price != blank %}
                  <s>{{ block.settings.combo_compare_price }}</s>
                {% endif %}
              </div>
              <a href="{{ block.settings.combo_link | default: '#bundles' }}" class="btn btn-ghost">Shop bundle<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>
            </div>
          </article>
        {% endfor %}
      </div>
      <div class="swipecue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>Swipe for more combos</div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Best-selling Combos",
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "text", "id": "combo_title", "label": "Combo title", "default": "Kitchen essentials" },
        { "type": "text", "id": "combo_desc", "label": "Description", "default": "Everything for a sparkling kitchen." },
        { "type": "text", "id": "combo_text", "label": "Save label", "default": "You save ₹398" },
        { "type": "text", "id": "combo_price", "label": "Combo price", "default": "₹499" },
        { "type": "text", "id": "combo_compare_price", "label": "Compare at price" },
        { "type": "text", "id": "combo_products", "label": "Product count label", "default": "3 products" },
        { "type": "url", "id": "combo_link", "label": "Link", "default": "/collections/all" },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" }
      ]
    }
  ],
  "presets": [{ "name": "Combos Rail" }]
}
{% endschema %}
