<section class="sec revband" id="reviews" data-scene="1" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">That&rsquo;s what they said</span>
      <span class="agg"><span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <b>4.8</b> from 8,000+ reviews</span>
      <span class="agg">Loved by <b>12 lakh+</b> homes</span>
    </div>
  </div>
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {% for block in section.blocks %}
      <article class="glass-2 rcard">
        <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <h5>{{ block.settings.title }}</h5>
        <p>{{ block.settings.body }}</p>
        <div class="who">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
          <b>{{ block.settings.author }}</b>
          <span>&middot; {{ block.settings.product }}</span>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews Rail",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review text",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product purchased",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Rail",
      "category": "Text",
      "blocks": [
        { "type": "review", "settings": { "title": "Works like a charm", "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.", "author": "Anita", "product": "Laundry detergent" } },
        { "type": "review", "settings": { "title": "Best dishwash ever", "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.", "author": "Priya", "product": "Dishwash gel" } },
        { "type": "review", "settings": { "title": "Great product, great packaging", "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.", "author": "Sunita", "product": "Liquid handwash" } },
        { "type": "review", "settings": { "title": "Dog friendly", "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.", "author": "Rohit S.", "product": "Floor cleaner" } },
        { "type": "review", "settings": { "title": "Sparkling taps again", "body": "Hard water had ruined our bathroom taps. Two sprays and they look new again.", "author": "Meera K.", "product": "Tap cleaner" } },
        { "type": "review", "settings": { "title": "Laundry smells fresh", "body": "I was worried natural detergent would not get out gym odour. It does, and the clothes feel softer too.", "author": "Arjun", "product": "Laundry detergent" } }
      ]
    }
  ]
}
{% endschema %}
