<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | default: "That's what they said" }}</span>
      <span class="agg"><span class="st">★★★★★</span> <b>{{ section.settings.rating | default: '4.8' }}</b> from {{ section.settings.review_count | default: '8,000+' }} reviews</span>
      <span class="agg">Loved by <b>{{ section.settings.homes | default: '12 lakh+' }}</b> homes</span>
    </div>
  </div>
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {% for block in section.blocks %}
        <article class="glass-2 rcard" {{ block.shopify_attributes }}>
          <div class="st">★★★★★</div>
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.text }}</p>
          <div class="who">
            {% if block.settings.avatar %}
              <span class="av"><img src="{{ block.settings.avatar | img_url: '80x' }}" alt="" loading="lazy"></span>
            {% else %}
              <span class="av" aria-hidden="true">{{ block.settings.initials | default: 'JD' }}</span>
            {% endif %}
            <span class="nm">{{ block.settings.name }}<br><small>{{ block.settings.detail | default: 'Verified buyer' }}</small></span>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "That's what they said" },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "8,000+" },
    { "type": "text", "id": "homes", "label": "Homes count", "default": "12 lakh+" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Works like a charm" },
        { "type": "textarea", "id": "text", "label": "Review text", "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better." },
        { "type": "text", "id": "name", "label": "Name", "default": "Priya S." },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Verified buyer" },
        { "type": "text", "id": "initials", "label": "Initials", "default": "PS" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" }
      ]
    }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
